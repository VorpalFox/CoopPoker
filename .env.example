# Discord Developer Portal > ton appli > Bot > Reset Token
DISCORD_TOKEN=
# Discord Developer Portal > ton appli > General Information > Application ID
DISCORD_CLIENT_ID=1572236813710663812
# Optionnel : ID de ton serveur (clic droit > Copier l'identifiant) pour que /poker apparaisse tout de suite
DISCORD_GUILD_ID=
# Optionnel : mail d'alerte quand le bot plante. Gmail : smtp.gmail.com, port 465, et un mot de passe
# d'application (compte Google > Sécurité > Mots de passe des applications), pas ton vrai mot de passe
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Destinataire, SMTP_USER par défaut
ALERT_EMAIL=
